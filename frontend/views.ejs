<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Residents</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#">Senior Facility</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/floors">Floors</a>
        <a class="nav-link" href="/rooms">Rooms</a>
        <a class="nav-link active" href="/residents">Residents</a>
        <a class="nav-link text-danger ms-auto" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <h2 class="fw-bold mb-4">Manage Residents</h2>

    <!-- Add Resident Form -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <h5 class="card-title fw-bold">Add New Resident</h5>
        <form action="/residents/add" method="POST" class="row g-3 mt-1">
          <div class="col-md-3">
            <label class="form-label">First Name</label>
            <input type="text" name="res_first_name" class="form-control" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Last Name</label>
            <input type="text" name="res_last_name" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="form-label">Age</label>
            <input type="number" name="res_age" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="form-label">Assigned Room</label>
            <select name="res_room" class="form-select" required>
              <option value="" disabled selected>Select Room</option>
              <% rooms.forEach(function(room) { %>
                <option value="<%= room.room_id %>">
                  Room #<%= room.room_number %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-success w-100">Add Resident</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Residents List Table (NO ID COLUMN DISPLAYED) -->
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>First Name</th>
              <th>Last Name</th>
              <th>Age</th>
              <th>Room Number</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% residents.forEach(function(resident) { %>
              <tr>
                <form action="/residents/update" method="POST">
                  <!-- Primary Key stored strictly in hidden input -->
                  <input type="hidden" name="res_id" value="<%= resident.res_id %>">
                  <td>
                    <input type="text" name="res_first_name" value="<%= resident.res_first_name %>" class="form-control form-control-sm" required>
                  </td>
                  <td>
                    <input type="text" name="res_last_name" value="<%= resident.res_last_name %>" class="form-control form-control-sm" required>
                  </td>
                  <td>
                    <input type="number" name="res_age" value="<%= resident.res_age %>" class="form-control form-control-sm" required>
                  </td>
                  <td>
                    <select name="res_room" class="form-select form-select-sm" required>
                      <% rooms.forEach(function(room) { %>
                        <option value="<%= room.room_id %>" <%= resident.res_room === room.room_id ? 'selected' : '' %>>
                          Room #<%= room.room_number %>
                        </option>
                      <% }); %>
                    </select>
                  </td>
                  <td>
                    <button type="submit" class="btn btn-sm btn-primary me-1">Update</button>
                    <button type="submit" formaction="/residents/delete" method="POST" class="btn btn-sm btn-danger">Delete</button>
                  </td>
                </form>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>