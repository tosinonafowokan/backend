<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Rooms</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#">Senior Facility</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/floors">Floors</a>
        <a class="nav-link active" href="/rooms">Rooms</a>
        <a class="nav-link" href="/residents">Residents</a>
        <a class="nav-link text-danger ms-auto" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <h2 class="fw-bold mb-4">Manage Rooms</h2>

    <!-- Add Room Form -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <h5 class="card-title fw-bold">Add New Room</h5>
        <form action="/rooms/add" method="POST" class="row g-3 mt-1">
          <div class="col-md-3">
            <label class="form-label">Room Number</label>
            <input type="number" name="room_number" class="form-control" placeholder="e.g. 201" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Capacity</label>
            <input type="number" name="room_capacity" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Assigned Floor</label>
            <select name="room_floor" class="form-select" required>
              <option value="" disabled selected>Select Floor Level</option>
              <% floors.forEach(function(floor) { %>
                <option value="<%= floor.floor_id %>">
                  <%= floor.floor_name %> (Level <%= floor.floor_level %>)
                </option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-success w-100">Add Room</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Rooms List Table (NO ID COLUMN DISPLAYED) -->
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>Room Number</th>
              <th>Capacity</th>
              <th>Floor</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rooms.forEach(function(room) { %>
              <tr>
                <form action="/rooms/update" method="POST">
                  <!-- Primary Key stored strictly in hidden input -->
                  <input type="hidden" name="room_id" value="<%= room.room_id %>">
                  <td>
                    <input type="number" name="room_number" value="<%= room.room_number %>" class="form-control form-control-sm" required>
                  </td>
                  <td>
                    <input type="number" name="room_capacity" value="<%= room.room_capacity %>" class="form-control form-control-sm" required>
                  </td>
                  <td>
                    <select name="room_floor" class="form-select form-select-sm" required>
                      <% floors.forEach(function(floor) { %>
                        <option value="<%= floor.floor_id %>" <%= room.room_floor === floor.floor_id ? 'selected' : '' %>>
                          <%= floor.floor_name %> (Level <%= floor.floor_level %>)
                        </option>
                      <% }); %>
                    </select>
                  </td>
                  <td>
                    <button type="submit" class="btn btn-sm btn-primary me-1">Update</button>
                    <button type="submit" formaction="/rooms/delete" method="POST" class="btn btn-sm btn-danger">Delete</button>
                  </td>
                </form>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
