<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Floors</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#">Senior Facility</a>
      <div class="navbar-nav">
        <a class="nav-link active" href="/floors">Floors</a>
        <a class="nav-link" href="/rooms">Rooms</a>
        <a class="nav-link" href="/residents">Residents</a>
        <a class="nav-link text-danger ms-auto" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <h2 class="fw-bold mb-4">Manage Floors</h2>

    <!-- Add Floor Form -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <h5 class="card-title fw-bold">Add New Floor</h5>
        <form action="/floors/add" method="POST" class="row g-3 mt-1">
          <div class="col-md-5">
            <label class="form-label">Floor Level</label>
            <input type="number" name="floor_level" class="form-control" required>
          </div>
          <div class="col-md-5">
            <label class="form-label">Floor Name</label>
            <input type="text" name="floor_name" class="form-control" required>
          </div>
          <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-success w-100">Add Floor</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Floors List Table (NO ID COLUMN DISPLAYED) -->
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>Floor Level</th>
              <th>Floor Name</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% floors.forEach(function(floor) { %>
              <tr>
                <form action="/floors/update" method="POST">
                  <!-- Primary Key stored strictly in hidden input -->
                  <input type="hidden" name="floor_id" value="<%= floor.floor_id %>">
                  <td>
                    <input type="number" name="floor_level" value="<%= floor.floor_level %>" class="form-control form-control-sm" required>
                  </td>
                  <td>
                    <input type="text" name="floor_name" value="<%= floor.floor_name %>" class="form-control form-control-sm" required>
                  </td>
                  <td>
                    <button type="submit" class="btn btn-sm btn-primary me-1">Update</button>
                    <button type="submit" formaction="/floors/delete" method="POST" class="btn btn-sm btn-danger">Delete</button>
                  </td>
                </form>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
